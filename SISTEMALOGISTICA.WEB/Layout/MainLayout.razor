@inherits LayoutComponentBase
 
<MudThemeProvider IsDarkMode="_isDark" Theme="@SISTEMALOGISTICA.WEB.Themes.CustomTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider CloseButton="true" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar style="border-bottom: 1px solid var(--mud-palette-divider)"
               Color="Color.Inherit"
               Elevation="0">

        @if (_open)
        {
            <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowLeft"
                           Color="Color.Default"
                           Edge="Edge.Start"
                           Class="pa-1"
                           Size="Size.Small"
                           Style="border: 1px solid var(--mud-palette-divider); border-radius:13px"
                           OnClick="ToggleDrawer" />
        }
        else
        {
            <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowRight"
                           Color="Color.Default"
                           Class="pa-1"
                           Size="Size.Small"
                           Style="border: 1px solid var(--mud-palette-divider); border-radius:13px"
                           Edge="Edge.Start"
                           OnClick="ToggleDrawer" />
        }

        @* <MudImage Width="266" Height="40" Fluid="true" Src="assets/images/logo-light.png"></MudImage> *@

        <MudSpacer />

        @if (_isDark)
        {
            <MudTooltip Text="Modo Claro">
                <MudIconButton Icon="@Icons.Material.Filled.WbSunny"
                               @onclick="@ThemeToggle" />
            </MudTooltip>
        }
        else
        {
            <MudTooltip Text="Modo Escuro">
                <MudIconButton Icon="@Icons.Material.Filled.DarkMode"
                               @onclick="@ThemeToggle" />
            </MudTooltip>
        }

        @* <MudIconButton Icon="@Icons.Material.Outlined.Logout" Color="Color.Inherit" OnClick="Logout" /> *@
    </MudAppBar>

    <MudDrawer @bind-Open="@_open"
               Breakpoint="Breakpoint.Lg"
               Elevation="1"
               Variant="@DrawerVariant.Mini">
        <NavMenu IsDarkMode="_isDark" IsMenuOpen="_open" />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _isDark = false;
    private bool _open = true;

    private void ThemeToggle()
    {
        _isDark = !_isDark;
    }

    private void ToggleDrawer()
    {
        _open = !_open;
    }
}