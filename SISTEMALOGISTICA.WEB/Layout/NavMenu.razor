<MudNavMenu>
    <MudText Typo="Typo.subtitle1" Class="ml-3 mt-3 w-700">
        SGM
    </MudText>
    <MudDivider Class="mt-2 mb-2" />

    <MudNavMenu Rounded="true" Margin="Margin.Dense" Class="ma-2">

        @* === GERAL === *@
        @if (IsMenuOpen)
        {
            <MudText Typo="Typo.caption" Class="pl-2 mt-2 w-700 mb-1 mud-text-secondary text-uppercase">
                Geral
            </MudText>
        }

        <MudNavLink Href="@AppRoutes.HOME"
                    ActiveClass="@(IsDarkMode ? "active-dark" : "active-light")"
                    Match="NavLinkMatch.All"
                    Icon="@Icons.Material.Outlined.Dashboard">
            Início
        </MudNavLink>

        @if (IsMenuOpen)
        {
            @* === COMERCIAL === *@
            <MudText Typo="Typo.caption" Class="pl-2 w-700 mt-4 mb-1 mud-text-secondary text-uppercase">
                Comercial
            </MudText>
        }

        <MudNavLink Href="@AppRoutes.CLIENTES"
                    ActiveClass="@(IsDarkMode ? "active-dark" : "active-light")"
                    Icon="@Icons.Material.Outlined.Groups">
            Clientes
        </MudNavLink>

        <MudNavLink Href="@AppRoutes.SERVICOS"
                    ActiveClass="@(IsDarkMode ? "active-dark" : "active-light")"
                    Icon="@Icons.Material.Outlined.Build">
            Serviços
        </MudNavLink>

        <MudNavLink Href="@AppRoutes.ORDENS_SERVICO"
                    ActiveClass="@(IsDarkMode ? "active-dark" : "active-light")"
                    Icon="@Icons.Material.Outlined.Assignment">
            Ordens Serviços
        </MudNavLink>

        <MudNavLink Href="@AppRoutes.ORCAMENTOS"
                    ActiveClass="@(IsDarkMode ? "active-dark" : "active-light")"
                    Icon="@Icons.Material.Outlined.ReceiptLong"
                    Disabled>
            Orçamentos
        </MudNavLink>
    </MudNavMenu>

</MudNavMenu>
@code {
    [Parameter]
    public bool IsDarkMode { get; set; }

    [Parameter]
    public bool IsMenuOpen { get; set; }
}

<style>
    .mud-nav-link-icon {
        margin-left: -8px !important;
    }

    .mud-nav-link-text {
        font-weight: 600;
    }

    /* === MODO LIGHT === */
    .active-light {
        background-color: #242C60 !important;
        color: #ffffff !important;
    }

        .active-light .mud-nav-link-icon {
            color: #ffffff !important;
        }

    /* === MODO DARK === */
    .active-dark {
        background-color: #181D35 !important;
        color: #ffffff !important;
    }

        .active-dark .mud-nav-link-icon {
            color: #ffffff !important;
        }

    .text-uppercase {
        text-transform: uppercase !important;
    }
</style>